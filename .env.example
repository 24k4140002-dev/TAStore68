# TAStore68 Pro — Environment Variables Template
# Copy this file to .env.local for local development, or add these variables in Vercel Project Settings.

# Meta Developer App Credentials (Required for permanent token exchange)
META_APP_ID=your_facebook_app_id_here
META_APP_SECRET=your_facebook_app_secret_here

# Meta Graph API Version (Default: v19.0)
META_GRAPH_VERSION=v19.0

# Optional: Supabase Database (if enabling cloud backend syncing)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
